# Copy to .env and fill in real values. Secrets must never be committed.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nairon_auth
DATABASE_URL_UNPOOLED=postgresql://postgres:your_password@localhost:5432/nairon_auth
JWT_SECRET=change-me
PORT=3009
DIRECT_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nairon_auth
FRONTEND_URL=
NODE_ENV=development

# Optional Prisma pool cap (default 8) — see src/prisma.service.ts
DB_POOL_LIMIT=8

# ─── OAuth 2.1 authorization server (ChatGPT / MCP) ──────────────────────────
# Nothing here is hard-coded to a domain: the same build runs locally and on the
# VPS, and only these values change.

# The `issuer` claim and the base of every published OAuth endpoint. Must be the
# URL that actually answers — locally the auth-api port, in production the public
# HTTPS host that nginx terminates.
#   local:      http://localhost:3002
#   production: https://auth.nairon.am
OAUTH_ISSUER_URL=http://localhost:3002
# Where a browser reaches this server. Normally identical to OAUTH_ISSUER_URL.
OAUTH_PUBLIC_BASE_URL=http://localhost:3002

# The MCP resource these tokens are bound to; becomes their `aud`. This is an
# identifier, not an address the internet has to reach — the MCP server itself
# stays on loopback and is published only through the tunnel.
MCP_RESOURCE_URL=http://127.0.0.1:3010/mcp

# Signs OAuth access tokens. MUST NOT equal JWT_SECRET: that separation is what
# makes an OAuth token useless if it ever reaches a domain API.
OAUTH_TOKEN_SECRET=change-me-to-a-long-random-value

# Host suffixes a client may register a redirect URI on. A policy, not a fixed
# callback, because the exact ChatGPT URI is not known until it registers.
OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,openai.com
# Permit http:// loopback redirect URIs. Development only; leave false in production.
OAUTH_ALLOW_LOOPBACK_REDIRECTS=true

# Lifetimes, in seconds. Access tokens are short because the refresh token
# rotates and revocation is checked on every exchange.
OAUTH_ACCESS_TOKEN_TTL_SEC=600
OAUTH_REFRESH_TOKEN_TTL_SEC=2592000
OAUTH_CODE_TTL_SEC=60
OAUTH_AUTHZ_REQUEST_TTL_SEC=600
# Lifetime of the internal Nairon JWT minted by the token exchange.
OAUTH_INTERNAL_TOKEN_TTL_SEC=300

# Highest entity id probed when listing workspaces for a user with a global role.
# Optional: lets the consent screen show workspace names instead of numbers.
# Uses the internal endpoint hr-api already exposes; requires INTERNAL_SECRET.
HR_API_URL=http://localhost:3001

# Authenticates the MCP host when it calls the token exchange. Its own variable,
# not INTERNAL_SECRET: setting that one here would switch InternalGuard on the
# pre-existing users/roles/permissions routes from fail-open to fail-closed.
# Unset means the exchange is disabled — it fails closed, by design.
MCP_EXCHANGE_SECRET=change-me-to-a-long-random-value
# The platform-wide internal secret, used only for the outbound call that names
# entities on the consent screen. Optional; without it workspaces show as ids.
HR_INTERNAL_SECRET=

# ─── Delegated read tokens for AI goals and workflows (V3 / V5) ──────────────
# Off unless exactly "true"; off, POST /api/internal/delegated-token answers 404.
# On, the caller (ai-api) authenticates with INTERNAL_SECRET in x-internal-secret,
# and HR_API_URL must be set: organisation membership is asked of hr-api at
# every mint, and without it every mint answers 503.
AUTH_DELEGATED_TOKENS_ENABLED=false

# ─── Delegated WRITE tokens for V3.4 standing approvals («Կանխավ հաստատում») ──
# Off unless exactly "true"; off, POST /api/internal/delegated-write-token answers
# 404. Independent of AUTH_DELEGATED_TOKENS_ENABLED (neither switches the other on).
# On, ai-api authenticates with AI_GOALS_WRITE_TOKEN_SECRET in x-goal-write-secret
# (the same value is set on ai-api). Its own secret: at least 32 characters and
# never equal to INTERNAL_SECRET, JWT_SECRET, MCP_EXCHANGE_SECRET or
# HR_INTERNAL_SECRET — otherwise every mint is refused (401). HR_API_URL must be
# set, as for read tokens. The owner must hold, literally in that organisation,
# use_ai_assistant + ai_long_goals + ai_write_actions + ai_standing_approvals and
# the tool's own right; the token lives 120 s and is bound to the one record
# (target) the approval froze: { chatId } or { taskId, itemId, quantity[, projectId] }.
AUTH_DELEGATED_WRITE_TOKENS_ENABLED=false
AI_GOALS_WRITE_TOKEN_SECRET=
