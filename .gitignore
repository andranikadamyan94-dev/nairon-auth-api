node_modules
dist
.env
# Local dev leftovers — never commit (secrets / runtime data)
.env.neon-backup
*.log

# Environment files — never commit a real one.
# Broad by design: listing individual names is how .env.staging was tracked
# with live credentials in it. Templates are opted back in explicitly.
.env*
!.env.example
!.env*.example
!.env.production
